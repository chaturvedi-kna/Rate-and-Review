# ==============================================================================
# Meesho Automation Studio - Cloud & Render Configuration (.env.example)
# DO NOT commit real secrets to GitHub! Add these in Render Dashboard -> Environment.
# ==============================================================================

# 1. Database (REQUIRED: Supabase PostgreSQL Connection URI)
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Flask Security (REQUIRED)
# 32+ character random secret string for session cookies (Render can auto-generate)
SECRET_KEY=change-this-to-a-random-32-char-secret-key-for-session-cookies

# 3. Initial Admin Password (REQUIRED)
# Used only during initial database creation to set the 'admin' password
ADMIN_PASSWORD=admin123

# 4. Telegram Userbot for Auto-Refresh (REQUIRED for Old Accounts refresh service)
# Copy the long string inside 'userbot.session.txt' and paste here:
TELEGRAM_STRING_SESSION=paste_the_contents_of_userbot_session_txt_here
TELEGRAM_API_ID=35009041
TELEGRAM_API_HASH=c0cc7d04faca251fbb0f8739927779b1

# 5. FamGateway UPI Payment Gateway (OPTIONAL - can also be set in Admin Panel)
# Your Merchant API key from https://famgateway.in/dashboard
FAMGATEWAY_API_KEY=your_famgateway_api_key_here

# 6. Indian Proxy for Meesho APIs (OPTIONAL - ProxyScrape is now automatic!)
# If left BLANK, the app automatically fetches and rotates 50+ free Indian proxies from ProxyScrape!
# If you have a paid dedicated Indian proxy, you can specify it here:
# Format: http://user:pass@ip:port or http://ip:port
INDIAN_PROXY=
