# ==============================================================================
# Meesho Automation Studio - Cloud & Render Configuration (.env.example)
# DO NOT commit the real .env to GitHub! Set these in Render Environment Variables.
# ==============================================================================

# 1. Database (Supabase PostgreSQL Connection URI)
# Find this in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Flask Web Security
SECRET_KEY=change-this-to-a-random-32-char-secret-key-for-session-cookies

# 3. Telegram Userbot (for automated token refresh via @Meeshojsoncheckerbot)
# Export string session using telethon and paste here:
TELEGRAM_API_ID=35009041
TELEGRAM_API_HASH=c0cc7d04faca251fbb0f8739927779b1
TELEGRAM_STRING_SESSION=your_telethon_string_session_here

# 4. FamGateway Automated UPI Payment Gateway
# Obtain your Merchant API key from https://famgateway.in/dashboard
FAMGATEWAY_API_KEY=your_famgateway_api_key_here

# 5. Indian Proxy for Meesho APIs (Crucial when hosting on Render outside India)
# Supports HTTP/HTTPS or SOCKS5 proxy, or set to 'auto' for public Indian proxy rotation
# Format: http://username:password@ip:port or http://ip:port
INDIAN_PROXY=http://your-indian-proxy-ip:port

# 6. Initial Administrator Password (Used only on initial database seed)
ADMIN_PASSWORD=admin123

